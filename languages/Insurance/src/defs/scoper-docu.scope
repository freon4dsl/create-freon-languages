scoper for language InsuranceModel

isNamespace { InsuranceProduct, BaseProduct, CalcFunction, Entity, AttributeRef }

InsuranceProduct {
    imports {
        self.basedOn;
    } 
}

AttributeRef {
	alternatives {
        self.owner().type();
    } 
}

Entity {
    imports {
        self.baseEntity;
    } 
}
